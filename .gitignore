.claude/projects/
.claude/remote-settings.json
.claude/session-env/
.claude/sessions/
.claude/shell-snapshots/

# thefuck generated config
.config/thefuck/

# Runtime/installed binaries and data under ~/.local
.local/bin/claude
.local/bin/env
.local/share/
.local/state/

# Cloud / tool credentials and runtime state
.config/gcloud/
.config/metabase-cli/
.config/pnpm/

# Editor backup copies
*.backup

# Secrets and runtime state written by tools under ~/.config and ~/.local
# (both are stowed as folded links into this repo)
.config/1Password/
.config/devbox-control/
.config/tmux-server/
# Work-specific (Datadog MCPs, monorepo rules). Move to dotfiles-work after ~/.config is unfolded.
.config/opencode/
.local/pipx/

# Claude settings.json is built from layers by scripts/claude-settings-build
.claude/settings.json
.claude/.settings.last-build.json
.claude/settings.work.json

# Local copies made before risky edits
*.before-*
