# General
.DS_Store
.AppleDouble
.LSOverride

# vim
*.swp
*.swo

.git/

.config/tmux/plugins/

.shell/secrets.bash
.gitconfig.local
.config/cheat/cheatsheets/

# Claude Code runtime state (~/.claude is stowed to this dir)
.claude/backups/
.claude/cache/
.claude/downloads/
.claude/file-history/
.claude/history.jsonl
.claude/mcp-needs-auth-cache.json
.claude/plugins/
.claude/policy-limits.json
.claude/projects/
.claude/remote-settings.json
.claude/session-env/
.claude/sessions/
.claude/shell-snapshots/

# thefuck generated config
.config/thefuck/

# Runtime/installed binaries and data under ~/.local
.local/bin/claude
.local/bin/env
.local/share/
.local/state/

# Cloud / tool credentials and runtime state
.config/gcloud/
.config/metabase-cli/
.config/pnpm/

# Editor backup copies
*.backup

# Secrets and runtime state written by tools under ~/.config and ~/.local
# (both are stowed as folded links into this repo)
.config/1Password/
.config/devbox-control/
.config/tmux-server/
.local/pipx/

# Built by scripts/claude-config-build; work and machine layers live elsewhere
.claude/settings.json
.claude/.*.last-build.json
.claude/*.work.json
.claude/*.machine.json

# Local copies made before risky edits
*.before-*

# Compatibility links (see .stow-global-ignore); no trailing slash, they are links
.local/share
.local/state
.local/bin/google-cloud-sdk
.config/gcloud
.config/nvm
