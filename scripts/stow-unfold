#!/usr/bin/env python3
"""Unfold stow folder links in $HOME that point into a dotfiles repo.

An old `stow .` without --no-folding links whole folders, e.g.
~/.config -> dotfiles/.config, so every tool that writes to ~/.config writes
into the repo. For each such link ~/D this script:

  1. moves every entry under <repo>/D that git does not track into a staging
     folder (rename only; nothing is copied),
  2. replaces the ~/D link with the staging folder,
  3. for each moved entry whose files contain the old absolute path
     <repo>/D/<entry>, leaves a compatibility link <repo>/D/<entry> -> ~/D/<entry>.

Then run `stow .` (the repo .stowrc sets --no-folding) to link tracked files.
Compatibility links must be in .gitignore (no trailing slash) and in
.stow-global-ignore as ^/<path>$; the script prints the lines to add.

Usage: stow-unfold [--run] [REPO]     (default: dry run, REPO=~/dotfiles)
"""
import os
import shutil
import subprocess
import sys

args = [a for a in sys.argv[1:] if a != "--run"]
run = "--run" in sys.argv
HOME = os.path.expanduser("~")
REPO = os.path.realpath(args[0] if args else os.path.join(HOME, "dotfiles"))

tracked = set(subprocess.check_output(
    ["git", "-C", REPO, "ls-files", "-z"]).decode().split("\0")) - {""}
tracked_dirs = {"/".join(p.split("/")[:i]) for p in tracked for i in range(1, p.count("/") + 1)}


def plan(rel, moves, mkdirs):
    with os.scandir(os.path.join(REPO, rel)) as it:
        for e in sorted(it, key=lambda e: e.name):
            r = f"{rel}/{e.name}"
            if r in tracked:
                continue
            if e.is_dir(follow_symlinks=False) and r in tracked_dirs:
                mkdirs.append(r)
                plan(r, moves, mkdirs)
            else:
                moves.append(r)


def embeds_old_path(path, old):
    """True if any file under path contains the string old."""
    if shutil.which("rg"):
        r = subprocess.run(["rg", "-uuu", "-l", "-F", "-m1", "-q", old, path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    r = subprocess.run(["grep", "-rlqF", old, path],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return r.returncode == 0


folded = sorted(
    e.name for e in os.scandir(HOME)
    if e.is_symlink() and os.path.isdir(e.path)
    and os.path.realpath(e.path) == os.path.join(REPO, e.name))
if not folded:
    print(f"nothing to unfold: no folder links in {HOME} point into {REPO}")
    sys.exit(0)

compat = []
for d in folded:
    link = os.path.join(HOME, d)
    if d not in tracked_dirs:
        print(f"skip {d}: git tracks nothing under it (remove the ~/{d} link by hand)")
        continue
    moves, mkdirs = [], []
    plan(d, moves, mkdirs)
    if not moves:
        print(f"skip {d}: no untracked data under it, so the link does no harm")
        continue
    print(f"{d}: move {len(moves)} untracked entries, {len(mkdirs)} mixed folders")
    for m in moves:
        print(f"   mv {m}")
    # Entries that have the old absolute path built into their files.
    needs = [m for m in moves
             if os.path.isdir(os.path.join(REPO, m)) and not os.path.islink(os.path.join(REPO, m))
             and embeds_old_path(os.path.join(REPO, m), os.path.join(REPO, m))]
    for m in needs:
        print(f"   compat link needed: {m}")
    compat += needs
    if not run:
        continue
    stage = link + ".unfold-staging"
    os.mkdir(stage)
    for m in mkdirs:
        os.makedirs(os.path.join(stage, m[len(d) + 1:]), exist_ok=True)
    for m in moves:
        os.rename(os.path.join(REPO, m), os.path.join(stage, m[len(d) + 1:]))
    os.remove(link)
    os.rename(stage, link)
    for m in needs:
        os.symlink(os.path.join(HOME, m), os.path.join(REPO, m))
    print(f"   ~/{d} is now a real folder")

if compat:
    print("\nAdd to .gitignore (if missing):")
    print("\n".join(compat))
    print("\nAdd to .stow-global-ignore (if missing):")
    print("\n".join("^/" + c.replace(".", "\\.") + "$" for c in compat))
print("\nNext: stow ." if run else "\nDry run. Run again with --run to apply.")
