#!/usr/bin/env bash
# Build ~/.claude/settings.json from layered files:
#
#   ~/.claude/settings.base.json   shared settings (public ~/dotfiles)
#   ~/.claude/settings.work.json   work-only settings (private ~/dotfiles-work),
#                                  used only when it exists
#
# Objects merge recursively. A value in the work file replaces the base value;
# arrays are replaced, not joined.
#
# Claude Code also writes to settings.json (/config, /plugin, auto mode).
# The script keeps a copy of what it last wrote. If settings.json changed since
# then, it stops and shows the change, so the change is not lost. Move the
# change into a layer file, then run again with --force.
#
# Usage: claude-settings-build [--check | --force]
#   --check  show the difference between settings.json and a new build; exit 1
#            if they differ
#   --force  write even if settings.json changed since the last build
set -euo pipefail

dir="$HOME/.claude"
base="$dir/settings.base.json"
work="$dir/settings.work.json"
out="$dir/settings.json"
last="$dir/.settings.last-build.json"

mode=write
case "${1:-}" in
  "") ;;
  -n | --check) mode=check ;;
  -f | --force) mode=force ;;
  -h | --help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "usage: claude-settings-build [--check | --force]" >&2
    exit 2
    ;;
esac

if [[ ! -f $base ]]; then
  echo "error: $base not found. Run 'stow .' in ~/dotfiles first." >&2
  exit 1
fi

layers=("$base")
[[ -f $work ]] && layers+=("$work")

new=$(jq -S -s 'reduce .[] as $layer ({}; . * $layer)' "${layers[@]}")

same_json() { # same_json FILE JSON
  jq -e --argjson want "$2" '. == $want' "$1" >/dev/null 2>&1
}

show_diff() { # show_diff OLD_FILE NEW_FILE_OR_JSON_LABEL...
  diff -u --label "$1" --label "$2" <(jq -S . "$3") <(printf '%s\n' "$4") || true
}

if [[ $mode == check ]]; then
  if [[ -f $out ]] && same_json "$out" "$new"; then
    echo "settings.json is up to date (${#layers[@]} layer(s))"
    exit 0
  fi
  [[ -f $out ]] && show_diff "settings.json" "new build" "$out" "$new"
  exit 1
fi

# Stop if Claude Code (or a person) changed settings.json since the last build.
if [[ $mode != force && -f $out && ! -L $out ]]; then
  if [[ -f $last ]]; then
    changed=$(cmp -s "$out" "$last" || echo yes)
  else
    changed=$(same_json "$out" "$new" || echo yes)
  fi
  if [[ -n ${changed:-} ]]; then
    echo "error: $out has changes that are not in the layer files:" >&2
    if [[ -f $last ]]; then
      diff -u --label "last build" --label "settings.json" <(jq -S . "$last") <(jq -S . "$out") >&2 || true
    else
      show_diff "settings.json" "new build" "$out" "$new" >&2
    fi
    echo "Move the changes into $base or $work, then run: claude-settings-build --force" >&2
    exit 1
  fi
fi

tmp=$(mktemp "$dir/.settings.json.XXXXXX")
printf '%s\n' "$new" >"$tmp"
mv -f "$tmp" "$out" # also replaces an old symlink
cp "$out" "$last"
echo "wrote $out from: ${layers[*]##*/}"
